# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# GITHUB_TOKEN — fine-grained PAT scoped to GITHUB_REPO, read-only on:
#   Contents · Pull requests · Actions · Deployments · Issues · Metadata
# Without it the GitHub and CI connectors fall back to replay mode against
# recorded cassettes; the API surface is identical.

GITHUB_TOKEN=
GITHUB_REPO=ShubhamMujumdar/payment-processing-app

# ArcadeDB — server mode requires a root password of 8+ characters.
ARCADE_ROOT_PASSWORD=
ARCADE_DB_PATH=./data/databases/spine

# Optional path overrides (default to ../docs/requirements and ../app_src
# relative to the dashboard root). Set these when the directories live
# somewhere other than the default REPO_ROOT locations.
# REQUIREMENTS_DIR=C:\path\to\docs\requirements
# APP_SRC_DIR=C:\path\to\app_src
