# Secrets — the GitHub PAT and the ArcadeDB root password live here.
# .env.example is committed; .env never is.
.env
*.pem
*.key

# ArcadeDB databases and generated fixture output — both reproducible.
# Anchored with a leading slash so it means *this* data/ only. Unanchored it
# also swallowed demo/data/, the committed Chroma index, which demo/.gitignore
# believed it was keeping.
/data/
*.arcadedb/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node (slice F)
node_modules/
.vite/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Service output. `logs/` is what scripts/run.py writes; `spine/log/` is
# ArcadeDB's own, which is singular and so slipped past the rule for weeks --
# committed, permanently dirty, and carrying absolute local paths.
logs/
spine/log/
code2doc_executive_rfp.pptx
*.zip
# ...except the graph snapshot, which is the one archive that is source rather
# than output. The live graph cannot be committed -- it is an ArcadeDB directory
# the server holds open -- so this 270KB zip is how a new machine gets one
# without a GITHUB_TOKEN. `run.py restore-graph` unpacks it.
!spine/graph-snapshot.zip
