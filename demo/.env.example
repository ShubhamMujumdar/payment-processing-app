# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# Create the API token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Confluence Cloud authenticates with HTTP Basic using your account email as
# the username and the API token as the password. The token inherits your own
# permissions -- there is no separate scope to grant, which is exactly why the
# write path defaults to refusing to run without an explicit flag.

CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# Model directories. Leave blank and they are searched for in, in order:
#   demo/models/ · ../models/ · ../../embedding/ · ../embedding/ · ~/.cache/code2doc/
# Set them only to override that search with a path of your own.
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=

# cuda | cpu | auto
DEVICE=auto

# API
API_PORT=8099

# GitHub watcher. Falls back to ../dashboard/.env if unset here.
GITHUB_TOKEN=
GITHUB_REPO=ShubhamMujumdar/payment-processing-app
WATCH_BRANCH=development
POLL_SECONDS=3

# Claude, for change analysis and redline generation.
ANTHROPIC_API_KEY=
