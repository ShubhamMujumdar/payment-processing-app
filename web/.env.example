# Copy to .env.local to change how the console gets its data.
#
# fixtures (default) - seeded, deterministic, rich. Every tab is populated.
#                      Use for demos: it reruns byte-identically.
# live               - reads the spine API. Only shows what has actually been
#                      ingested, so tabs without a connector yet are empty.
#                      That emptiness is the honest state, not a bug.
#
# Start the API first:  cd spine && ./.venv/Scripts/python -m spine.cli serve

VITE_SPINE_MODE=fixtures
VITE_SPINE_URL=http://127.0.0.1:8077
